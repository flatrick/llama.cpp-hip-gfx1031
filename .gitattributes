# Normalise all text files to LF on checkin
* text=auto eol=lf

# Explicit text + LF for key source types
*.py        text eol=lf
*.sh        text eol=lf
*.toml      text eol=lf
*.json      text eol=lf
*.md        text eol=lf
*.yaml      text eol=lf
*.yml       text eol=lf
Dockerfile* text eol=lf

# Binary — never normalise
*.log       binary
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.pdf       binary
*.zip       binary
*.tar.gz    binary
*.whl       binary
*.so        binary
